# ---------------------------------------------------------------------------
# Plantilla de variables de entorno del backend de Musicboxd.
# Copiar este archivo a `.env` y completar los valores reales.
# El archivo `.env` NO se commitea (ver .gitignore).
# ---------------------------------------------------------------------------

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# Orígenes del frontend habilitados para CORS, separados por coma.
# Vite levanta en 5173, pero si ese puerto está ocupado por otro proyecto se pasa
# al siguiente libre (5174, 5175...). Por eso se listan varios: si el origen no
# está acá, el navegador bloquea TODAS las llamadas del frontend a la API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Base de datos (MySQL 8) ---
# El puerto depende de cada máquina. Si tenés XAMPP instalado, su MariaDB ocupa
# el 3306 y conviene correr MySQL 8 en otro puerto (por ejemplo 3307).
# Ver la sección "Base de datos local" del README.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=musicboxd
# El backend NO se conecta como root: se usa un usuario con permisos acotados
# al esquema musicboxd (ver el script de creación en el README).
DB_USER=musicboxd_app
DB_PASSWORD=

# SSL: en MySQL local va en false.
# Al pasar a un servicio cloud (Aiven, Clever Cloud) hay que ponerlo en true
# y pegar el certificado CA que provee el servicio en DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=

# Si está en true, Sequelize crea/actualiza las tablas al arrancar (sequelize.sync).
# Sirve durante el desarrollo. En producción debe ir en false.
DB_SYNC=true

# Muestra por consola el SQL que ejecuta Sequelize. Útil para depurar.
DB_LOGGING=true

# --- Autenticación ---
# JWT_SECRET es OBLIGATORIO: es la clave con la que se firman los tokens. Si falta,
# el servidor no arranca. Para desarrollo alcanza con cualquier cadena larga; para
# producción generar una aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Con NODE_ENV=production el servidor NO arranca si el secreto tiene menos de 32
# caracteres o si es el valor de ejemplo de abajo.
JWT_SECRET=dev-secret-cambiar-antes-de-produccion
# Duración del token: '7d', '12h', '30m'...
JWT_EXPIRES_IN=7d

# --- Pasarela de pago (MercadoPago Checkout Pro, sandbox) ---
# Access token de PRUEBA de la aplicación de MercadoPago. Empieza con "TEST-".
# Se saca de mercadopago.com.ar/developers -> Tus integraciones -> tu app ->
# Credenciales de prueba. Si está vacío el servidor arranca igual: solo falla el
# checkout, con un mensaje que explica que falta esta variable.
MERCADOPAGO_ACCESS_TOKEN=

# URL base de la API de MercadoPago. Solo se cambia para apuntar a un mock en los tests.
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com

# Moneda de los precios de los planes.
MERCADOPAGO_CURRENCY=ARS

# A dónde vuelve el usuario después de pagar. Es una página del FRONTEND, no de la
# API. Si el frontend corre en otro puerto (5174, 5175...), hay que ajustarla.
MERCADOPAGO_BACK_URL=http://localhost:5173/pro/return

# A dónde avisa MercadoPago cuando cambia el estado de un pago (webhook).
# Tiene que ser una URL PÚBLICA: a localhost no le llega nada. Se deja vacía en
# desarrollo, y ahí la confirmación la resuelve la pantalla de retorno.
# Para probar el webhook de verdad hay que exponer el backend, por ejemplo con
# ngrok, y poner acá https://<lo-que-de-ngrok>/api/payments/webhook
MERCADOPAGO_NOTIFICATION_URL=

# --- Usuario administrador inicial (lo crea `npm run seed`) ---
# Con estos valores por defecto la base queda usable sin configurar nada.
# Cambiar la contraseña si el entorno es compartido. Con NODE_ENV=production el
# seed se niega a crear el admin si SEED_ADMIN_PASSWORD no está definida.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@musicboxd.com
SEED_ADMIN_PASSWORD=Admin1234!

# --- Servicio de metadata musical (Deezer) ---
# Lo usa ÚNICAMENTE `npm run seed:fetch`, que se corre a mano una sola vez para
# descargar el catálogo a backend/src/seed/data/*.json (archivos versionados en git).
# Ni la API ni el frontend consultan este servicio en runtime.
# No necesita credenciales: los endpoints que se usan son públicos.
METADATA_API_BASE_URL=https://api.deezer.com
# Espera entre pedidos, en ms. Deezer limita a ~50 pedidos cada 5 segundos por IP.
METADATA_REQUEST_DELAY_MS=150
METADATA_MAX_RETRIES=4
