# Conexión a Supabase (PostgreSQL)
# Copiá este archivo a .env y completá con tus valores.
# Preferido: connection string completo de Supabase (Database Settings -> Connection string)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Alternativa: conexión por variables individuales (hosting propio u otro proveedor Postgres)
# DB_NAME=nombre_base
# DB_USER=usuario
# DB_PASS=password
# DB_HOST=localhost
# DB_PORT=5432

# Puerto del servidor Express (opcional, por defecto 3000)
# PORT=3000

# En el deploy poner "production": activa cookies Secure y oculta los mensajes internos de error
NODE_ENV=development

# ---------- Autenticación ----------
# Secreto para firmar los JWT (mínimo 32 caracteres). Cada integrante genera el suyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en minutos (por defecto 60)
# JWT_EXPIRES_MINUTES=60

# Origen(es) del frontend autorizados, separados por coma
FRONTEND_ORIGIN=http://localhost:5173
# Dejar en lax: el frontend reenvía /api al backend (Vite en local, Vercel en producción),
# así que la cookie siempre es del mismo sitio. none solo si se llama al backend directo desde otro dominio.
COOKIE_SAMESITE=lax
# Cantidad de proxies delante del server en el deploy (ej. 1 en Render/Railway)
# TRUST_PROXY=1

# Solo para `pnpm run create-admin`. Borrar ADMIN_PASSWORD una vez creado el admin.
# ADMIN_EMAIL=admin@powertrainer.com
# ADMIN_PASSWORD=
