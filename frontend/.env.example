VITE_API_URL=http://localhost:3000/api

# Access key de Web3Forms (https://web3forms.com): recibe el formulario de /contact
# y lo reenvía por mail. Es pública por diseño (viaja en el bundle del frontend),
# pero igual no se versiona: se pide gratis con el mail que va a recibir los mensajes.
VITE_WEB3FORMS_URL=https://api.web3forms.com/submit
VITE_WEB3FORMS_ACCESS_KEY=tu-access-key-de-web3forms

# --- Tests end-to-end (Playwright) ---
# Opcionales: sin ellas se usan los valores locales por defecto y el admin del
# seed. Playwright las lee del entorno de la terminal, no de este archivo.
# E2E_FRONTEND_URL=http://localhost:5173
# E2E_BACKEND_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=admin@musicboxd.com
# E2E_ADMIN_PASSWORD=Admin1234!
