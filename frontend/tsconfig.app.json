{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,      //cambiados momentaneamente
    "noUnusedParameters": true,  //cambiados momentaneamente
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    // ← Las tuyas que ya tenías, las mantenés
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}